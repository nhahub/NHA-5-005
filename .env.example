# Copy to .env and change the example paths to match your machine.
LLM_PROVIDER=llamacpp
LLM_MODEL=qwen35-4b-local
LLAMA_CPP_BASE_URL=http://127.0.0.1:8081
STT_PROVIDER=faster_whisper
LOCAL_STT_MODEL_PATH=D:/Ollama Models/stt/whisper-arabic-int8
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_LANGUAGE=ar-EG
TTS_PROVIDER=hag_shalaby
HAG_PYTHON=D:/Ollama Models/tts/hag-shalaby-benchmark/.venv/Scripts/python.exe
HAG_MODEL_PATH=D:/Ollama Models/tts/hag-shalaby-benchmark/model
HAG_HF_CACHE=D:/Ollama Models/cache/huggingface
HAG_DEVICE=cuda
# Optional fallback: TTS_PROVIDER=kemetone
LOCAL_TTS_MODEL_PATH=D:/Ollama Models/tts/kemetone
DB_PATH=restaurant.db
